(defun test-atomic-swap (work)
  (let ((left (namestring (merge-pathnames "left" work)))
        (right (namestring (merge-pathnames "right" work))))
    (write-file (merge-pathnames "left/version" work) "old")
    (write-file (merge-pathnames "right/version" work) "new")
    (let ((observer (uiop:launch-program
                     (list "bash" "-c"
                           "touch \"$1/ready\"; while [[ ! -e \"$1/stop\" ]]; do [[ -d \"$1/left\" ]] || touch \"$1/missing\"; done"
                           "observer" (namestring work)))))
      (unwind-protect
          (progn
            (loop repeat 100 until (probe-file (merge-pathnames "ready" work)) do (sleep 0.01))
            (assert (probe-file (merge-pathnames "ready" work)))
            (dotimes (index 100)
              (uiop:run-program (list (namestring *install-tool*) left right))
              (assert (equal (if (evenp index) "new" "old")
                             (uiop:read-file-string (merge-pathnames "left/version" work))))))
        (write-file (merge-pathnames "stop" work) "")
        (uiop:wait-process observer)))
    (assert (not (probe-file (merge-pathnames "missing" work))))
    (uiop:run-program (list "ln" "-s" left (namestring (merge-pathnames "link" work))))
    (dolist (arguments (list (list left left) (list left (namestring (merge-pathnames "absent" work)))
                            (list left (namestring (merge-pathnames "link" work)))
                            (list left (namestring (merge-pathnames "right/version" work)))))
      (let ((failed nil))
        (handler-case (uiop:run-program (cons (namestring *install-tool*) arguments))
          (uiop:subprocess-error () (setf failed t)))
        (assert failed))
      (assert (equal "old" (uiop:read-file-string (merge-pathnames "left/version" work))))
      (assert (equal "new" (uiop:read-file-string (merge-pathnames "right/version" work)))))))

(defun bundle-hash (app)
  (let* ((output (uiop:run-program (list "/usr/bin/codesign" "-dvvv" (namestring app))
                                    :output :string :error-output :output))
         (start (search "CDHash=" output)))
    (assert start)
    (subseq output start (position #\Newline output :start start))))

(defun test-signed-install (work)
  (copy-install-script work)
  (install-support-tool work)
  (let* ((source (merge-pathnames "source.app/" work))
         (target (merge-pathnames "installed.app/" work))
         (arguments (list (namestring source) (namestring target))))
    (write-file (merge-pathnames "Contents/Info.plist" source)
                "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict><key>CFBundleIdentifier</key><string>local.meltype.SwapTests</string><key>CFBundleExecutable</key><string>Meltype</string><key>CFBundlePackageType</key><string>APPL</string><key>CFBundleVersion</key><string>1</string></dict></plist>")
    (write-file (merge-pathnames "Contents/Resources/version" source) "A")
    (uiop:run-program (list "cp" "/usr/bin/true" (namestring (merge-pathnames "Contents/MacOS/Meltype" source))))
    (uiop:run-program (list "/usr/bin/codesign" "--force" "--deep" "--sign" "-" (namestring source)))
    (run-script work "install-app.sh" arguments)
    (let ((first-hash (bundle-hash target))
          (outer-inode (uiop:run-program (list "stat" "-f" "%i" (namestring target)) :output :string)))
      (uiop:run-program (list "xattr" "-w" "com.apple.quarantine" "0083;12345678;Fixture;" (namestring target)))
      (uiop:run-program (list "xattr" "-w" "com.example.meltype-test" "keep" (namestring target)))
      (write-file (merge-pathnames ".DS_Store" target) "Finder metadata")
      (write-file (merge-pathnames ".DS_Store" source) "New Finder metadata")
      (write-file (merge-pathnames "Contents/Resources/version" source) "B")
      (write-file (merge-pathnames "Contents/Info.plist" source)
                  (replace-text (uiop:read-file-string (merge-pathnames "Contents/Info.plist" source))
                                "<string>1</string>" "<string>2</string>"))
      (uiop:run-program (list "/usr/bin/codesign" "--force" "--deep" "--sign" "-" (namestring source)))
      (run-script work "install-app.sh" arguments)
      (let ((second-hash (bundle-hash target)))
        (assert (equal "Finder metadata" (uiop:read-file-string (merge-pathnames ".DS_Store" target))))
        (assert (not (equal first-hash second-hash)))
        (assert (equal second-hash (bundle-hash source)))
        (assert (equal outer-inode (uiop:run-program (list "stat" "-f" "%i" (namestring target)) :output :string)))
        (assert (equal (format nil "keep~%")
                       (uiop:run-program (list "xattr" "-p" "com.example.meltype-test" (namestring target)) :output :string)))
        (assert (not (search "com.apple.quarantine" (uiop:run-program (list "xattr" (namestring target)) :output :string))))
        ;; Failed validation after replacing Contents must restore B's signature.
        (uiop:run-program (list "xattr" "-w" "com.apple.quarantine" "0083;12345678;Previous;" (namestring target)))
        (uiop:run-program (list "xattr" "-w" "com.apple.quarantine" "0083;12345678;PreviousContents;" (namestring (merge-pathnames "Contents" target))))
        (write-file (merge-pathnames "Contents/Resources/version" source) "C")
        (uiop:run-program (list "/usr/bin/codesign" "--force" "--deep" "--sign" "-" (namestring source)))
        (fake-tool work "codesign"
                   "app=\"${@: -1}\"; if [[ \"${app%/}\" == */installed.app && $(cat \"$app/Contents/Resources/version\") == C ]]; then exit 23; fi; exec /usr/bin/codesign \"$@\"")
        (let ((status nil))
          (handler-case (run-script work "install-app.sh" arguments)
            (uiop:subprocess-error (condition) (setf status (uiop:subprocess-error-code condition))))
          (assert (eql 23 status)))
        (assert (equal second-hash (bundle-hash target)))
        (assert (not (search "com.apple.quarantine"
                             (uiop:run-program (list "xattr" (namestring target)) :output :string))))
        (assert (equal (format nil "0083;12345678;PreviousContents;~%")
                       (uiop:run-program (list "xattr" "-p" "com.apple.quarantine" (namestring (merge-pathnames "Contents" target))) :output :string)))
        (assert (equal outer-inode (uiop:run-program (list "stat" "-f" "%i" (namestring target)) :output :string)))
        (uiop:run-program (list "/usr/bin/codesign" "--verify" "--deep" "--strict" (namestring target))))
      ;; A tampered update must fail before stopping the installed IME.
      (write-file (merge-pathnames "Contents/Resources/version" source) "tampered")
      (write-file (merge-pathnames "calls" work) "")
      (let ((failed nil))
        (handler-case (run-script work "install-app.sh" arguments)
          (uiop:subprocess-error () (setf failed t)))
        (assert failed))
      (assert (null (uiop:read-file-lines (merge-pathnames "calls" work)))))
    (assert (equal "B" (uiop:read-file-string (merge-pathnames "Contents/Resources/version" target))))))

