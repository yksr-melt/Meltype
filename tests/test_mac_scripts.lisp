                              "let status: OSStatus = CommandLine.arguments.count > 2 ? Int32(CommandLine.arguments[2])! : noErr"))
    (setf source (replace-text source "/usr/bin/killall" (namestring (merge-pathnames "killall" work))))
    (write-file (merge-pathnames "registrar.swift" work) source)
    (write-file (merge-pathnames "Contents/Info.plist" app)
                "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict><key>CFBundleIdentifier</key><string>local.meltype.RegistrarFixture</string><key>CFBundlePackageType</key><string>APPL</string></dict></plist>")
    (uiop:run-program (list "xcrun" "swiftc" (namestring (merge-pathnames "registrar.swift" work)) "-o" (namestring binary)))
    (dolist (code '(0 1 23))
      (fake-tool work "killall" (format nil "exit ~D" code))
      (multiple-value-bind (output errors status)
          (uiop:run-program (list (namestring binary) (namestring app))
                            :output :string :error-output :output :ignore-error-status t)
        (declare (ignore errors))
        (assert (= 0 status))
        (when (= code 1) (assert (search "プロセスはありません" output)))))
    ;; 更新指定でも登録失敗・有効化保留は維持し、メニュー再起動は行わない。
    (let ((called (merge-pathnames "menu-restart-called" work)))
      (fake-tool work "killall" (format nil "touch ~S; exit 23" (namestring called)))
      (dolist (scenario '(("0") ("0" "pending") ("-50")))
        (multiple-value-bind (output errors status)
            (uiop:run-program (append (list (namestring binary) (namestring app)) scenario
                                     '("--keep-input-menu"))
                              :output :string :error-output :output :ignore-error-status t)
          (declare (ignore output errors))
          (assert (= (cond ((equal (first scenario) "-50") 1)
                           ((second scenario) 2) (t 0)) status))
          (assert (not (probe-file called))))))
    (dolist (scenario '(("0" "pending") ("-50")))
      (multiple-value-bind (output errors status)
          (uiop:run-program (append (list (namestring binary) (namestring app)) scenario)
                            :output :string :error-output :output :ignore-error-status t)
        (declare (ignore errors))
        (assert (= (if (equal (first scenario) "0") 2 1) status))
        (assert (search (if (= status 2) "システム設定" "登録できませんでした") output))))))

(defun test-pending-activation-keeps-app (unused)
  (declare (ignore unused))
  (dolist (mode '(initial update homebrew source))
    (call-with-work-directory
     (lambda (work)
       (test-distributed-install work)
       (unless (eq mode 'update)
         (uiop:delete-directory-tree (merge-pathnames "installed/Meltype.app/" work) :validate t))
       (write-file (merge-pathnames "Meltype.app/Contents/version" work) "new")
       (write-file (merge-pathnames "calls" work) "")
       (fake-tool work "Meltype.app/Contents/MacOS/MeltypeRegisterInputSource" "exit 2")
       (let ((output (make-string-output-stream)))
         (let ((*standard-output* output) (*error-output* output))
           (if (eq mode 'source)
               (run-script work "install-app.sh"
                           (list (namestring (merge-pathnames "Meltype.app" work))
                                 (namestring (merge-pathnames "installed/Meltype.app" work))))
               (run-script work "install.sh" (if (eq mode 'homebrew) '("--homebrew") nil))))
         (let ((message (get-output-stream-string output)))
           (assert (search "有効化は保留中" message))
           (assert (search "システム設定" message))))
       ;; Pending activation must not hide a subsequent startup failure.
       (when (eq mode 'update)
         (write-file (merge-pathnames "Meltype.app/Contents/version" work) "broken")
         (fake-tool work "start-input-method.sh" "exit 23")
         (let ((status 0))
           (handler-case (run-script work "install.sh" nil)
             (uiop:subprocess-error (condition)
               (setf status (uiop:subprocess-error-code condition))))
           (assert (= status 23))))
       (assert (equal "new" (uiop:read-file-string (merge-pathnames "installed/Meltype.app/Contents/version" work))))
       (let ((calls (uiop:read-file-lines (merge-pathnames "calls" work))))
         (assert (member "started" calls :test #'equal))
         (assert (not (member "stopped" calls :test #'equal))))))))

(defun test-selection-failure-keeps-update (work)
  (copy-install-script work)
  (write-file (merge-pathnames "source.app/Contents/version" work) "new")
  (write-file (merge-pathnames "installed.app/Contents/version" work) "old")
  (install-support-tool work)
  (write-file (merge-pathnames "running" work) "")
  (fake-tool work "ditto" "cp -R \"$1\" \"$2\"")
  (fake-tool work "codesign" "exit 0")
  (fake-tool work "source.app/Contents/MacOS/MeltypeInstallSupport"
             (format nil "if [[ \"$1\" == --restore ]]; then touch \"$MELTYPE_START_LOG_DIR/running\"; exit 2; fi~%exec ~S \"$@\""
                     (namestring (merge-pathnames "fixture-support" work))))
  ;; The outer installer must not contradict the selection failure warning.
  (call-with-work-directory
   (lambda (installer-work)
     (test-distributed-install installer-work)
     (fake-tool installer-work "Meltype.app/Contents/MacOS/MeltypeInstallSupport"
                (format nil "if [[ \"$1\" == --restore ]]; then exit 2; fi~%exec ~S \"$@\""
                        (namestring (merge-pathnames "fixture-support" installer-work))))
     (let ((output (make-string-output-stream)))
       (let ((*standard-output* output) (*error-output* output))
         (run-script installer-work "install.sh" nil))
       (let ((message (get-output-stream-string output)))
         (assert (search "入力ソースを戻せませんでした" message))
         (assert (search "Meltype を更新しました。" message))
         (assert (not (search "選択を維持します" message)))))))
  (let ((receipt (merge-pathnames "receipt" work))
        (output (make-string-output-stream)))
    (let ((*standard-output* output) (*error-output* output))
      (run-script work "install-app.sh"
                  (list (namestring (merge-pathnames "source.app" work))
                        (namestring (merge-pathnames "installed.app" work)) "manual" (namestring receipt))))
    (assert (search "入力メニューから選び直してください" (get-output-stream-string output)))
    (assert (equal "update" (first (uiop:read-file-lines receipt)))))
  (assert (equal "new" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))
  (assert (probe-file (merge-pathnames "running" work))))


