(defun test-native-application-lifecycle (work)
  ;; A unique background app has no input-method identity or input handlers.
  ;; This exercises real AppKit stop/start without changing the selected IME.
  (let* ((app (merge-pathnames "LifecycleFixture.app/" work))
         (state (merge-pathnames "input-state.json" work))
         (before (merge-pathnames "selected-before.json" work))
         (ready (merge-pathnames "ready" work))
         (job (format nil "local.meltype.manual-job.~A" (car (last (pathname-directory work))))))
    (write-file (merge-pathnames "fixture.swift" work)
                (format nil "import AppKit~%NSApplication.shared.setActivationPolicy(.prohibited)~%DispatchQueue.main.async { FileManager.default.createFile(atPath: ~S, contents: nil) }~%NSApplication.shared.run()~%" (namestring ready)))
    (write-file (merge-pathnames "Contents/Info.plist" app)
                (format nil "<?xml version=\"1.0\"?><plist version=\"1.0\"><dict><key>CFBundleIdentifier</key><string>local.meltype.Lifecycle.~A</string><key>CFBundleExecutable</key><string>Fixture</string><key>CFBundlePackageType</key><string>APPL</string><key>LSBackgroundOnly</key><true/></dict></plist>"
                        (car (last (pathname-directory work)))))
    (ensure-directories-exist (merge-pathnames "Contents/MacOS/Fixture" app))
    (uiop:run-program (list "xcrun" "swiftc" (namestring (merge-pathnames "fixture.swift" work))
                           "-o" (namestring (merge-pathnames "Contents/MacOS/Fixture" app))))
    (uiop:run-program (list "codesign" "--force" "--deep" "--sign" "-" (namestring app)))
    (uiop:run-program (list (namestring *install-tool*) "--validate-bundle" (namestring app)))
    (write-file (merge-pathnames ".DS_Store" app) "Finder metadata")
    (uiop:run-program (list (namestring *install-tool*) "--validate-bundle" (namestring app)))
    (uiop:run-program (list "codesign" "--verify" "--deep" "--strict" (namestring app)))
    (delete-file (merge-pathnames ".DS_Store" app))
    (write-file (merge-pathnames "outside" work) "do not modify")
    (uiop:run-program (list "ln" "-s" (namestring (merge-pathnames "outside" work))
                           (namestring (merge-pathnames ".DS_Store" app))))
    (multiple-value-bind (output errors status)
        (uiop:run-program (list (namestring *install-tool*) "--validate-bundle" (namestring app))
                          :output :string :error-output :output :ignore-error-status t)
      (declare (ignore errors))
      (assert (= 1 status))
      (assert (search "Move it outside the app" output)))
    (assert (equal "do not modify" (uiop:read-file-string (merge-pathnames "outside" work))))
    (delete-file (merge-pathnames ".DS_Store" app))
    (write-file (merge-pathnames "unexpected-root-payload" app) "preserve me")
    (let ((failed nil))
      (handler-case (uiop:run-program (list (namestring *install-tool*) "--validate-bundle" (namestring app)))
        (uiop:subprocess-error () (setf failed t)))
      (assert failed))
    (delete-file (merge-pathnames "unexpected-root-payload" app))
    (unwind-protect
        (progn
          ;; Start the fixture under a manual job that can relaunch the executable.
          (uiop:run-program (list "/bin/launchctl" "submit" "-l" job "--"
                                  (namestring (merge-pathnames "Contents/MacOS/Fixture" app))))
          (loop repeat 100 until (probe-file ready) do (sleep 0.1))
          (assert (probe-file ready))
          (uiop:run-program (list (namestring *install-tool*) "--stop" (namestring app) (namestring app)
                                  (namestring state) job))
          (assert (search "\"wasRunning\":true" (uiop:read-file-string state)))
          (multiple-value-bind (out err status)
              (uiop:run-program (list "/bin/launchctl" "list" job) :ignore-error-status t :error-output :string)
            (declare (ignore out err))
            (assert (not (zerop status))))
          (uiop:run-program (list (namestring *install-tool*) "--start" (namestring app)))
          (uiop:run-program (list (namestring *install-tool*) "--stop" (namestring app) (namestring app) (namestring state)))
          (let ((saved (uiop:read-file-string state)))
            (assert (search "\"wasRunning\":true" saved))
            (assert (not (search "temporarySourceID" saved))))
          (uiop:copy-file state before)
          (uiop:run-program (list (namestring *install-tool*) "--restore" (namestring app) (namestring state)))
          (uiop:run-program (list (namestring *install-tool*) "--stop" (namestring app) (namestring app) (namestring state)))
          (assert (equal (uiop:read-file-string before) (uiop:read-file-string state))))
      (uiop:run-program (list "/bin/launchctl" "remove" job) :ignore-error-status t :error-output :string)
      (uiop:run-program (list (namestring *install-tool*) "--stop" (namestring app) (namestring app) (namestring state))
                        :ignore-error-status t)
      (uiop:run-program (list "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
                             "-u" (namestring app)) :ignore-error-status t))))

