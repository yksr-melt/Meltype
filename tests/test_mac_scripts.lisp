(defun test-install-rollback (work)
  (copy-install-script work)
  (write-file (merge-pathnames "source.app/Contents/version" work) "new")
  (write-file (merge-pathnames "installed.app/Contents/version" work) "previous")
  (install-support-tool work)
  (fake-tool work "pkill" "echo stopped >> \"$MELTYPE_TEST_LOG\"")
  (dolist (failure '("copy" "signature" "replace"))
    (write-file (merge-pathnames "calls" work) "")
    (fake-tool work "ditto" (if (equal failure "copy") "exit 23" "cp -R \"$1\" \"$2\""))
    (fake-tool work "codesign" (if (equal failure "signature") "exit 23" "exit 0"))
    (if (equal failure "replace")
        (fake-tool work "source.app/Contents/MacOS/MeltypeInstallSupport"
                   (format nil "if [[ \"$1\" == --* ]]; then exec ~S \"$@\"; fi; exit 23" (namestring (merge-pathnames "fixture-support" work))))
        (install-support-tool work))
    (let ((status nil))
      (handler-case
          (run-script work "install-app.sh"
                      (list (namestring (merge-pathnames "source.app" work))
                            (namestring (merge-pathnames "installed.app" work))))
        (uiop:subprocess-error (condition)
          (setf status (uiop:subprocess-error-code condition))))
      (assert (eql 23 status)))
    (assert (equal "previous" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))
    (unless (equal failure "replace")
      (assert (null (uiop:read-file-lines (merge-pathnames "calls" work)))))))

(defun test-partial-install-rollback (work)
  (test-install-rollback work)
  (install-support-tool work)
  (fake-tool work "codesign"
             "if [[ \"${@: -1}\" == */installed.app ]]; then exit 23; fi")
  (fake-tool work "mktemp"
             "mkdir -p \"$MELTYPE_START_LOG_DIR/staging\"; echo \"$MELTYPE_START_LOG_DIR/staging\"")
  (dolist (restore-fails '(nil t))
    (fake-tool work "source.app/Contents/MacOS/MeltypeInstallSupport"
               (format nil "if [[ \"$1\" == --* ]]; then exec ~S \"$@\"; fi~%~A~%touch \"$MELTYPE_START_LOG_DIR/swapped\"~%exec ~S \"$@\""
                       (namestring (merge-pathnames "fixture-support" work))
                       (if restore-fails
                           "if [[ -f \"$MELTYPE_START_LOG_DIR/swapped\" ]]; then exit 27; fi"
                           "")
                       (namestring (merge-pathnames "fixture-support" work))))
    (when (probe-file (merge-pathnames "swapped" work))
      (delete-file (merge-pathnames "swapped" work)))
    (let ((status nil))
      (handler-case
          (run-script work "install-app.sh"
                      (list (namestring (merge-pathnames "source.app" work))
                            (namestring (merge-pathnames "installed.app" work))))
        (uiop:subprocess-error (condition)
          (setf status (uiop:subprocess-error-code condition))))
      (assert (eql 23 status)))
    (if restore-fails
        (progn
          (assert (equal "previous" (uiop:read-file-string (merge-pathnames "staging/Meltype.app/Contents/version" work))))
          (assert (equal "new" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work)))))
        (progn
          (assert (equal "previous" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))
          (assert (not (probe-file (merge-pathnames "staging" work))))))))

(defun test-successful-install (work)
  (copy-install-script work)
  (write-file (merge-pathnames "source.app/Contents/version" work) "new")
  (install-support-tool work)
  (dolist (name '("pkill" "codesign")) (fake-tool work name "exit 0"))
  (fake-tool work "ditto" "cp -R \"$1\" \"$2\"")
  ;; First installation, followed by replacement of a version without the helper.
  (dotimes (index 2)
    (when (= index 1)
      (uiop:delete-directory-tree (merge-pathnames "installed.app/Contents/" work) :validate t)
      (write-file (merge-pathnames "installed.app/Contents/version" work) "previous"))
    (run-script work "install-app.sh"
                (list (namestring (merge-pathnames "source.app" work))
                      (namestring (merge-pathnames "installed.app" work))))
    (assert (equal "new" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))
    (assert (equal "new" (uiop:read-file-string (merge-pathnames "source.app/Contents/version" work))))))

(defun test-first-install-partial-failure (work)
