;;; Run with: sbcl --script tests/test_mac_scripts.lisp
;;; Exercise routing with fake tools; never touch the installed input method.
(require :asdf)

(defparameter *root*
  (uiop:pathname-parent-directory-pathname
   (uiop:pathname-directory-pathname *load-truename*)))

(defvar *install-tool*)

(defun write-file (path text)
  (ensure-directories-exist path)
  (with-open-file (stream path :direction :output :if-exists :supersede)
    (write-string text stream)))

(defun fake-tool (work name body)
  (let ((path (merge-pathnames name work)))
    (write-file path (format nil "#!/bin/bash~%~A~%" body))
    (uiop:run-program (list "chmod" "+x" (namestring path)))))

(defun run-script (work name argument)
  (uiop:run-program
   (append (list "env"
                 (concatenate 'string "PATH=" (namestring work) ":" (uiop:getenv "PATH"))
                 (concatenate 'string "MELTYPE_TEST_LOG="
                              (namestring (merge-pathnames "calls" work)))
                 (concatenate 'string "MELTYPE_START_LOG_DIR=" (namestring work))
                 "bash" (namestring (merge-pathnames name work)))
           (if (listp argument) argument (list argument)))
   :output *standard-output* :error-output *error-output*))

(defun call-with-work-directory (test)
  (let ((work (uiop:ensure-directory-pathname
               (string-trim '(#\Newline #\Return)
                            (uiop:run-program
                             '("mktemp" "-d" "/tmp/meltype-lisp-tests.XXXXXX")
                             :output :string)))))
    (unwind-protect (funcall test work)
      (uiop:delete-directory-tree work :validate t))))

(defun test-build-only (work)
  (write-file (merge-pathnames "build-cli.sh" work)
              (uiop:read-file-string (merge-pathnames "mac/build-cli.sh" *root*)))
  (fake-tool work "build.sh" "echo \"$*\" >> \"$MELTYPE_TEST_LOG\"")
  (dolist (name '("dotnet" "swift")) (fake-tool work name "exit 0"))
  (run-script work "build-cli.sh" "--build")
  (assert (equal '("--no-install")
                 (uiop:read-file-lines (merge-pathnames "calls" work)))))

(defun test-update (work)
  (let* ((source (uiop:read-file-string (merge-pathnames "mac/update.sh" *root*)))
         (original "$HOME/Library/Input Methods/Meltype.app")
         (position (search original source))
         (app (namestring (merge-pathnames "Meltype.app" work))))
    (assert position)
    (write-file (merge-pathnames "update.sh" work)
                (concatenate 'string (subseq source 0 position) app
                             (subseq source (+ position (length original))))))
  (fake-tool work "Meltype.app/Contents/MacOS/Meltype"
             "echo \"app:$*\" >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "build-cli.sh"
             "echo \"build:$*\" >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "uname" "echo Darwin")
  (fake-tool work "start-input-method.sh"
             "echo UNEXPECTED_START >> \"$MELTYPE_TEST_LOG\"; exit 99")
  (fake-tool work "swift" "echo select >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "open" "echo UNEXPECTED_OPEN >> \"$MELTYPE_TEST_LOG\"; exit 1")
  (run-script work "update.sh" nil)
  (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
    (assert (equal "build:--test --install" (first lines)))
    (assert (uiop:string-prefix-p "app:--check-inputs " (second lines)))
    (assert (member "select" lines :test #'equal))
    (assert (not (member "UNEXPECTED_START" lines :test #'equal)))
    (assert (not (member "UNEXPECTED_OPEN" lines :test #'equal)))))

(defun test-os-startup (work)
  (write-file (merge-pathnames "start-input-method.sh" work)
              (uiop:read-file-string (merge-pathnames "mac/start-input-method.sh" *root*)))
  (fake-tool work "fixture-helper" "echo \"$*\" >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "launchctl" "[[ \"$1\" == list ]] && exit 1; echo UNEXPECTED_DAEMON_START >> \"$MELTYPE_TEST_LOG\"; exit 99")
  (run-script work "start-input-method.sh" (list "/tmp/Meltype.app" (namestring (merge-pathnames "fixture-helper" work))))
  (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
    (assert (equal '("--start /tmp/Meltype.app") lines))))

(defun test-update-failure-recovery (work)
  (test-update work)
  (dolist (failure '("build" "check"))
    (write-file (merge-pathnames "calls" work) "")
    (fake-tool work "build-cli.sh" (if (equal failure "build") "exit 23" "exit 0"))
    (fake-tool work "Meltype.app/Contents/MacOS/Meltype"
               (format nil "echo \"app:$*\" >> \"$MELTYPE_TEST_LOG\"~%exit ~D"
                       (if (equal failure "check") 23 0)))
    (let ((status nil))
      (handler-case (run-script work "update.sh" nil)
        (uiop:subprocess-error (condition)
          (setf status (uiop:subprocess-error-code condition))))
      (assert (eql 23 status)))
    (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
      (if (equal failure "build")
          (assert (null lines))
          (progn
            (assert (= 1 (length lines)))
            (assert (uiop:string-prefix-p "app:--check-inputs " (first lines))))))))

(defun test-os-startup-failure (work)
  (test-os-startup work)
  (write-file (merge-pathnames "calls" work) "")
  (fake-tool work "fixture-helper" "echo failed >> \"$MELTYPE_TEST_LOG\"; exit 23")
  (let ((status nil))
    (handler-case (run-script work "start-input-method.sh" (list "/tmp/Meltype.app" (namestring (merge-pathnames "fixture-helper" work))))
      (uiop:subprocess-error (condition) (setf status (uiop:subprocess-error-code condition))))
    (assert (eql 23 status)))
  (assert (equal '("failed") (uiop:read-file-lines (merge-pathnames "calls" work))))
  ;; The helper owns the handoff and removal so the old job cannot relaunch mid-stop.
  (write-file (merge-pathnames "calls" work) "")
  (fake-tool work "fixture-helper" "echo \"$*\" >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "launchctl" "if [[ \"$1\" == list ]]; then exit 0; fi; echo \"$*\" >> \"$MELTYPE_TEST_LOG\"")
  (run-script work "start-input-method.sh" (list "/tmp/Meltype.app" (namestring (merge-pathnames "fixture-helper" work))))
  (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
    (assert (uiop:string-prefix-p "--stop /tmp/Meltype.app /tmp/Meltype.app " (first lines)))
    (assert (uiop:string-suffix-p (first lines) " io.github.yksr-melt.Meltype.manual"))
    (assert (uiop:string-prefix-p "--restore /tmp/Meltype.app " (second lines)))
    (assert (equal "--start /tmp/Meltype.app" (third lines)))))

(defun test-failed-start-does-not-select (work)
  (test-distributed-install work)
  (write-file (merge-pathnames "calls" work) "")
  (fake-tool work "start-input-method.sh" "exit 1")
  (let ((failed nil))
    (handler-case (run-script work "install.sh" nil)
      (uiop:subprocess-error () (setf failed t)))
    (assert failed))
  (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
    (assert (not (member "selected" lines :test #'equal)))))

(defun replace-text (text old new)
  (with-output-to-string (out)
    (loop with start = 0
          for position = (search old text :start2 start)
          do (write-string text out :start start :end position)
          while position
          do (write-string new out)
             (setf start (+ position (length old))))))

(defun copy-install-script (work)
  (write-file (merge-pathnames "install-app.sh" work)
              (replace-text
               (uiop:read-file-string (merge-pathnames "mac/install-app.sh" *root*))
               "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
               "lsregister"))
  (fake-tool work "lsregister" "exit 0")
  (fake-tool work "pgrep" "exit 1")
  (fake-tool work "pkill" "echo UNEXPECTED_KILL >> \"$MELTYPE_TEST_LOG\"; exit 99")
  (fake-tool work "launchctl" "exit 1")
  (unless (probe-file (merge-pathnames "start-input-method.sh" work))
    (fake-tool work "start-input-method.sh" "echo restarted >> \"$MELTYPE_TEST_LOG\"")))

(defun install-support-tool (work &optional (prefix "source.app"))
  ;; Registration is part of the transaction; fixture apps must supply both commands.
  (dolist (name '("Meltype" "MeltypeRegisterInputSource"))
    (let ((relative (concatenate 'string prefix "/Contents/MacOS/" name)))
      (unless (probe-file (merge-pathnames relative work))
        (fake-tool work relative "exit 0"))))
  (let ((tool (merge-pathnames (concatenate 'string prefix "/Contents/MacOS/MeltypeInstallSupport") work))
        (fixture (merge-pathnames "fixture-support" work)))
    ;; Model AppKit operations separately from the real kernel swap/lock. This
    ;; suite must never stop or select the developer's installed input method.
    (unless (probe-file fixture)
      (fake-tool work "fixture-support"
                 (format nil "case \"$1\" in~%--validate-bundle) exit 0 ;;~%--stop) if [[ -f \"$MELTYPE_START_LOG_DIR/running\" ]]; then [[ \"$4\" == - ]] || echo 1 > \"$4\"; rm \"$MELTYPE_START_LOG_DIR/running\"; echo stopped >> \"$MELTYPE_TEST_LOG\"; else [[ \"$4\" == - ]] || echo 0 > \"$4\"; fi; exit 0 ;;~%--restore) if [[ $(cat \"$3\") == 1 ]]; then touch \"$MELTYPE_START_LOG_DIR/running\"; echo restarted >> \"$MELTYPE_TEST_LOG\"; fi; exit 0 ;;~%--start) echo started >> \"$MELTYPE_TEST_LOG\"; exit 0 ;;~%esac~%exec ~S \"$@\"" (namestring *install-tool*))))
    (ensure-directories-exist tool)
    (uiop:copy-file fixture tool)
    (uiop:run-program (list "chmod" "+x" (namestring tool)))))

(defun test-distributed-install (work)
  (let ((source (uiop:read-file-string (merge-pathnames "mac/install.sh" *root*))))
    (write-file (merge-pathnames "install.sh" work)
                (replace-text
                 (replace-text source "$HOME/Library/Input Methods"
                               (namestring (merge-pathnames "installed" work)))
                 "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"
                 "lsregister")))
  (fake-tool work "Meltype.app/Contents/MacOS/Meltype"
             "echo \"app:$*\" >> \"$MELTYPE_TEST_LOG\"")
  (install-support-tool work "Meltype.app")
  (fake-tool work "Meltype.app/Contents/MacOS/MeltypeRegisterInputSource" "exit 0")
  (fake-tool work "start-input-method.sh"
             "echo started >> \"$MELTYPE_TEST_LOG\"")
  (copy-install-script work)
  (fake-tool work "ditto" "cp -R \"$1\" \"$2\"")
  (fake-tool work "codesign" "exit 0")
  (write-file (merge-pathnames "select-input-source.swift" work) "// fake selector")
  (fake-tool work "swift" "echo selected >> \"$MELTYPE_TEST_LOG\"")
  (dolist (name '("pkill" "killall" "xattr" "lsregister"))
    (fake-tool work name "exit 0"))
  (fake-tool work "killall" "echo UNEXPECTED_MENU_REFRESH >> \"$MELTYPE_TEST_LOG\"")
  (fake-tool work "open" "echo UNEXPECTED_OPEN >> \"$MELTYPE_TEST_LOG\"; exit 1")
  (run-script work "install.sh" nil)
  (assert (equal '("app:--register-input-source" "started" "selected")
                 (uiop:read-file-lines (merge-pathnames "calls" work)))))

(defun test-update-keeps-input-menu (work)
  (test-distributed-install work)
  (fake-tool work "Meltype.app/Contents/MacOS/MeltypeRegisterInputSource"
             "echo helper:${2:-initial} >> \"$MELTYPE_TEST_LOG\"")
  ;; 同じ入口でも、既存アプリの更新にだけ両コマンドへ指定する。
  (dolist (update '(t nil))
    (unless update
      (uiop:delete-directory-tree (merge-pathnames "installed/Meltype.app/" work) :validate t))
    (write-file (merge-pathnames "calls" work) "")
    (run-script work "install.sh" nil)
    (let ((lines (uiop:read-file-lines (merge-pathnames "calls" work))))
      (assert (member (if update "app:--register-input-source --keep-input-menu"
                         "app:--register-input-source") lines :test #'equal))
      (assert (member (if update "helper:--keep-input-menu" "helper:initial") lines :test #'equal)))))

(defun test-main-registration-keeps-input-menu (work)
  ;; 本体の登録コマンドをそのままコンパイルし、登録APIとkillallだけをスタブ化する。
  (let* ((source (uiop:read-file-string (merge-pathnames "mac/Sources/MeltypeIME/main.swift" *root*)))
         (end (search "/// 変換の候補の一覧" source))
         (binary (merge-pathnames "main-registrar" work))
         (called (merge-pathnames "menu-restart-called" work)))
    (assert end)
    (setf source (replace-text (subseq source 0 end) "/usr/bin/killall"
                              (namestring (merge-pathnames "killall" work))))
    (write-file (merge-pathnames "main-registrar.swift" work)
                (concatenate 'string source
                             "enum InputSourceRegistration { enum Outcome { case ready, pending, failed; var exitCode: Int32 { self == .failed ? 1 : 0 } }; static func register() -> Outcome { if CommandLine.arguments.contains(\"failed\") { return .failed }; return CommandLine.arguments.contains(\"pending\") ? .pending : .ready } }"))
    (fake-tool work "killall" (format nil "touch ~S; exit 0" (namestring called)))
    (uiop:run-program (list "xcrun" "swiftc" (namestring (merge-pathnames "main-registrar.swift" work)) "-o" (namestring binary)))
    (dolist (keep '(nil t))
      (dolist (outcome '("ready" "pending" "failed"))
        (when (probe-file called) (delete-file called))
        (multiple-value-bind (output errors status)
            (uiop:run-program (append (list (namestring binary) "--register-input-source" outcome)
                                     (when keep '("--keep-input-menu")))
                              :output :string :error-output :output :ignore-error-status t)
          (declare (ignore output errors))
          (assert (= (if (equal outcome "failed") 1 0) status))
          (assert (eq (not (null (probe-file called))) (and (not keep) (equal outcome "ready")))))))))

(defun test-incomplete-package (work)
