(defun test-concurrent-install (work)
  (copy-install-script work)
  (dolist (name '("source-a.app" "source-b.app")) (install-support-tool work name))
  (write-file (merge-pathnames "source-a.app/Contents/version" work) "A")
  (write-file (merge-pathnames "source-b.app/Contents/version" work) "B")
  (fake-tool work "pkill" "exit 0")
  (fake-tool work "ditto" "cp -R \"$1\" \"$2\"")
  (fake-tool work "codesign"
             "target=\"${@: -1}\"; if [[ \"$target\" == */installed.app && $(cat \"$target/Contents/version\") == A ]]; then touch \"$MELTYPE_START_LOG_DIR/ready\"; for _ in {1..200}; do [[ -f \"$MELTYPE_START_LOG_DIR/release\" ]] && exit 23; sleep 0.05; done; exit 24; fi")
  ;; Cover both a new install and an update. The first installer deliberately
  ;; fails validation after placing A, while a second installer tries to place B.
  (dolist (previous '(nil t))
    (when previous (write-file (merge-pathnames "installed.app/Contents/version" work) "previous"))
    (dolist (name '("ready" "release"))
      (when (probe-file (merge-pathnames name work)) (delete-file (merge-pathnames name work))))
    (let* ((command (list "env"
                          (concatenate 'string "PATH=" (namestring work) ":" (uiop:getenv "PATH"))
                          (concatenate 'string "MELTYPE_START_LOG_DIR=" (namestring work))
                          "bash" (namestring (merge-pathnames "install-app.sh" work))
                          (namestring (merge-pathnames "source-a.app" work))
                          (namestring (merge-pathnames "installed.app" work))))
           (first (uiop:launch-program command :output (merge-pathnames "first.log" work)
                                               :error-output (merge-pathnames "first-error.log" work))))
      (unwind-protect
          (progn
            (loop repeat 500 until (probe-file (merge-pathnames "ready" work)) do (sleep 0.01))
            (assert (probe-file (merge-pathnames "ready" work)))
            (let ((status nil))
              (handler-case
                  (run-script work "install-app.sh"
                              (list (namestring (merge-pathnames "source-b.app" work))
                                    (namestring (merge-pathnames "installed.app" work))))
                (uiop:subprocess-error (condition)
                  (setf status (uiop:subprocess-error-code condition))))
              (assert (eql 75 status)))
            (assert (equal "A" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work)))))
        (write-file (merge-pathnames "release" work) "")
        (assert (= 23 (uiop:wait-process first)))))
    (if previous
        (assert (equal "previous" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))
        (assert (not (probe-file (merge-pathnames "installed.app" work)))))
    ;; The lock must be released after failure, so retrying B succeeds.
    (run-script work "install-app.sh"
                (list (namestring (merge-pathnames "source-b.app" work))
                      (namestring (merge-pathnames "installed.app" work))))
    (assert (equal "B" (uiop:read-file-string (merge-pathnames "installed.app/Contents/version" work))))))

(defun test-post-install-failures (unused)
  (declare (ignore unused))
  ;; Manual updates must restore the old app on registration or startup failure, even when it was stopped.
  ;; Homebrew has already removed the old app, so keep the new app and report a warning.
  (dolist (homebrew '(nil t))
    (dolist (failure '("registration" "helper" "launchservices" "startup" "startup-pending"))
      (call-with-work-directory
       (lambda (work)
         (test-distributed-install work)
         (write-file (merge-pathnames "installed/Meltype.app/Contents/version" work) "old")
         (write-file (merge-pathnames "Meltype.app/Contents/version" work) "new")
         (when homebrew
           (uiop:delete-directory-tree (merge-pathnames "installed/Meltype.app/" work) :validate t))
         (write-file (merge-pathnames "calls" work) "")
         (when (equal failure "startup-pending")
           (fake-tool work "Meltype.app/Contents/MacOS/MeltypeRegisterInputSource" "exit 2"))
         (fake-tool work (cond ((equal failure "registration") "Meltype.app/Contents/MacOS/Meltype")
                               ((equal failure "helper") "Meltype.app/Contents/MacOS/MeltypeRegisterInputSource")
                               ((equal failure "launchservices") "lsregister")
                               (t "start-input-method.sh"))
                    "[[ \"$1\" == -u ]] && exit 0; touch \"$MELTYPE_START_LOG_DIR/running\"; echo failed >> \"$MELTYPE_TEST_LOG\"; exit 23")
         (let ((status 0) (output (make-string-output-stream)))
           (let ((*standard-output* output) (*error-output* output))
             (handler-case (run-script work "install.sh" (if homebrew '("--homebrew") nil))
               (uiop:subprocess-error (condition)
                 (setf status (uiop:subprocess-error-code condition)))))
           (assert (= (if homebrew 0 23) status))
           (when homebrew
             (assert (search "Meltype を入れましたが、登録か起動が終わりませんでした。ログアウトしてログインし直してから、入力メニューで Meltype を選んでください。"
                             (get-output-stream-string output)))))
         (assert (equal (if homebrew "new" "old")
                        (uiop:read-file-string (merge-pathnames "installed/Meltype.app/Contents/version" work))))
         (assert (eq homebrew (not (null (probe-file (merge-pathnames "running" work))))))
         (let ((calls (uiop:read-file-lines (merge-pathnames "calls" work))))
           (assert (member "failed" calls :test #'equal))
           (assert (eq (not homebrew) (not (null (member "stopped" calls :test #'equal)))))
           (when (and homebrew (not (member failure '("startup" "startup-pending") :test #'equal)))
             (assert (member "started" calls :test #'equal)))
           (assert (not (member "restarted" calls :test #'equal)))
           (assert (not (member "selected" calls :test #'equal)))))))))

