  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/yksr-melt/Meltype.git",
    "directory": "web-engine"
  },
  "type": "module",
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    },
    "./meltype.js": "./meltype.js",
    "./meltype.css": "./meltype.css"
  },
  "files": [
    "index.mjs",
    "index.d.ts",
    "meltype.js",
    "meltype.css",
    "_framework/",
    "mozc/",
    "LICENSE",
