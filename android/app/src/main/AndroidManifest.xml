<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        学習データ、絵文字の「最近使ったもの」、設定を、別の端末やクラウドに写さない（spec 09）。
        allowBackup="false" だけでは、Android 12 以降の端末から端末への引き継ぎが止まらないので、
        すべてのデータを外す規則も付ける（Android 12 以降は dataExtractionRules、それより前は fullBackupContent）。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:enableOnBackInvokedCallback="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LicensesActivity"
            android:exported="false" />
        <!-- BIND_INPUT_METHOD は、このサービスをシステムだけが呼べるようにする属性。権限の要求ではない。 -->
        <service
            android:name=".KeyboardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
