{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "meltype-web",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/report/*", "/dashboard", "/dashboard/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meltype-reports",
      "migrations_dir": "migrations"
    }
  ],
  // R2 (添付の置き場)。外すと添付の欄を出さず、報告の文章だけ受け付ける (web/README.md)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "meltype-report-files" }],
  "kv_namespaces": [
    {
      "binding": "CACHE"
    }
  ],
  "vars": {
    "GITHUB_REPO": "yksr-melt/Meltype",
    "SITE_ORIGIN": "https://meltype.moe",
    "ACCESS_TEAM_DOMAIN": "ibutya.cloudflareaccess.com",
    "ACCESS_AUD": "716cd096cf0cb7613e380828caa833792db38e1c6ab29be24e1904d110a5561c",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFbE1tRx2mNEqCl5",
    "TURNSTILE_HOSTNAMES": "meltype.moe",
    "FILE_RETENTION_DAYS": "30",
    "REPORT_RETENTION_DAYS": "180"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
