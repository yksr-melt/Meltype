[Desktop Entry]
# GNOME の設定の入力ソースは、IBus のエンジン名から ibus-setup-<エンジン名>.desktop を探して「設定」から開く。
# アプリの一覧 (ランチャー) にも出す (fcitx5 だけで使う人も、ここから開く)。
# build-deb.sh・build-rpm.sh が @DIR@ をインストール先に置き換える。
Type=Application
Name=Meltype の設定
Comment=日本語入力 Meltype の設定を変える
Exec=@DIR@/meltype-settings
Icon=@DIR@/icon.png
Categories=Settings;
# Avalonia が X11 の WM_CLASS に入れる名前 (実行ファイルの元のアセンブリ名)
StartupWMClass=MeltypeSettings
