ROLE_KEYS = {IBus.KEY_Henkan: 0x1C, IBus.KEY_Muhenkan: 0x1D, IBus.KEY_Hiragana_Katakana: 0x15}

# 半角/全角: 英数 (直接入力) ⇔ 日本語。英数・ひらがなのキーでも切り替える (JIS キーボード)。
ZENKAKU_HANKAKU_KEYS = (IBus.KEY_Zenkaku_Hankaku, IBus.KEY_Hankaku, IBus.KEY_Zenkaku)
ALWAYS_DIRECT_KEYS = (IBus.KEY_Eisu_toggle, IBus.KEY_Muhenkan)
MODE_SWITCH_KEYS = ZENKAKU_HANKAKU_KEYS + ALWAYS_DIRECT_KEYS + (IBus.KEY_Hiragana_Katakana, IBus.KEY_Henkan)

# IBus の修飾キー → 本体が使うビット (Shift=1, Ctrl=2, Alt=4, Win=8)
MODIFIER_BITS = (
    (IBus.ModifierType.SHIFT_MASK, 1),
    (IBus.ModifierType.CONTROL_MASK, 2),
    (IBus.ModifierType.MOD1_MASK, 4),
    (IBus.ModifierType.SUPER_MASK | IBus.ModifierType.MOD4_MASK, 8),
)


def modifier_flags(state):
    """IBus の state から、本体へ渡す修飾キーのビットを作る。"""
    return sum(bit for mask, bit in MODIFIER_BITS if state & mask)


def _report_url():
    """不具合報告を開く URL (OS・版・実行環境を入れたもの)。"""
    pointer = _lib.meltype_report_url(b"Linux")
    if not pointer:
        return "https://github.com/yksr-melt/Meltype/issues/new/choose"
    try:
        return ctypes.string_at(pointer).decode("utf-8")
    finally:
        _lib.meltype_free(pointer)

if not _lib.meltype_init_mozc(os.path.join(HERE, "mozc", "meltype_mozc_helper").encode(), None):
    print("Meltype: Mozc を使えません (漢字変換はひらがなのままになります)", file=sys.stderr)


def _result(pointer):
    """本体が返した JSON (SessionResult) を読んで解放する。NULL なら None (キーはアプリに渡す)。"""
    if not pointer:
        return None
    try:
        return json.loads(ctypes.string_at(pointer).decode("utf-8"))
    finally:
        _lib.meltype_free(pointer)


# ---- キー: IBus のキー (keyval) → Meltype の本体が使う Windows の仮想キーコード ----

# 文字を入力するキーで、特別な扱いのないもの (記号など)。本体では文字だけを見る。
OTHER_CHARACTER_KEY = 0x07

SPECIAL_KEYS = {
    IBus.KEY_Return: 0x0D, IBus.KEY_KP_Enter: 0x0D, IBus.KEY_Tab: 0x09, IBus.KEY_ISO_Left_Tab: 0x09,
    IBus.KEY_space: 0x20,
    IBus.KEY_BackSpace: 0x08, IBus.KEY_Delete: 0x2E, IBus.KEY_Escape: 0x1B,
    IBus.KEY_Left: 0x25, IBus.KEY_Up: 0x26, IBus.KEY_Right: 0x27, IBus.KEY_Down: 0x28,
    IBus.KEY_Home: 0x24, IBus.KEY_End: 0x23, IBus.KEY_Page_Up: 0x21, IBus.KEY_Page_Down: 0x22,
    IBus.KEY_F6: 0x75, IBus.KEY_F7: 0x76, IBus.KEY_F8: 0x77, IBus.KEY_F9: 0x78, IBus.KEY_F10: 0x79,
}

SYMBOL_KEYS = {",": 0xBC, ".": 0xBE, "-": 0xBD, "/": 0xBF, "[": 0xDB, "]": 0xDD}


def virtual_key(keyval):
    """(仮想キーコード, 入力する文字) を返す。Meltype が扱わないキーなら (None, 0)。

    英字の仮想キーへ写像するのは ASCII の A-Z / a-z だけにする。以前は character.lower() してから
    ord() を呼んでいたため、トルコ語の İ (U+0130) のように小文字化で 1 文字でなくなる (i + 結合ドット)
    文字で例外になっていた。非 ASCII は小文字化せず、元のコードポイントのまま他文字キーとして渡す。
    """
    if keyval in SPECIAL_KEYS:
        return SPECIAL_KEYS[keyval], (0x20 if keyval == IBus.KEY_space else 0)
    character = IBus.keyval_to_unicode(keyval)
    # 空・複数スカラーは ord() の前に弾く (先頭 1 文字へ黙って切り詰めない)。
    if not character or len(character) != 1:
        return None, 0
    codepoint = ord(character)
    if codepoint < 0x20:
        return None, 0
    if "A" <= character <= "Z":
        return codepoint, codepoint
    if "a" <= character <= "z":
        return codepoint - 0x20, codepoint
    if "0" <= character <= "9":
        return codepoint, codepoint
    return SYMBOL_KEYS.get(character, OTHER_CHARACTER_KEY), codepoint


# ---- 入力エンジン ----

class MeltypeEngine(IBus.Engine):
    __gtype_name__ = "MeltypeEngine"

    def __init__(self):
        super().__init__()
        self._session = _lib.meltype_create()
        self._direct = False
        self._preedit_visible = False
        # 表示中の preedit の文字列 (フォーカスが外れたとき、この分は IBus が確定する)
        self._preedit_text = ""
        # 入力欄が周りの文字 (surrounding text) に対応しているか (本体の既定は「消せる」)
        self._can_delete = True
        # 確定し直しが実際に効いたかを次の入力で確かめるための期待値 (効かなければ以降やめる)
        self._replace_expect = None
        # 入力欄がターミナルでコード入力になっているか。日本語の指定は本体だけで持つ。
        self._code_input = False
        self._lookup = IBus.LookupTable.new(9, 0, True, True)
        self._lookup.set_orientation(IBus.Orientation.VERTICAL)
        self._candidates = []
        # 候補で少し (1.5 秒) 止まったら、その候補の意味を補助テキストに出す (Windows 版と同じ)
        self._meaning_key = None
        # 入力メソッドのメニュー (GNOME の入力ソースのメニューなど) に出す項目
        self._properties = IBus.PropList()
        self._properties.append(IBus.Property(key="report", label=IBus.Text.new_from_string("不具合の報告・提案… (Linux 版はプレビュー版です)"),
                                              type=IBus.PropType.NORMAL, sensitive=True, visible=True))

    # IBus からの呼び出し

    def do_process_key_event(self, keyval, keycode, state):
        self._check_replace()
        if state & IBus.ModifierType.RELEASE_MASK or not self._session:
            return False
        # 入力中の 変換・無変換・ひらがな/カタカナ: 設定で役割を分けていれば、本体が変換ボックスで処理する (#199)
        if keyval in ROLE_KEYS and _role_key is not None and not self._direct:
            pointer = _role_key(self._session, ROLE_KEYS[keyval])
            if pointer:
                self._apply(_result(pointer))
                return True
        if keyval in MODE_SWITCH_KEYS:
            self._switch_mode(keyval)
            return True
        vk, character = virtual_key(keyval)
        if vk is None:
            return False
        modifiers = modifier_flags(state)
        before, after = (None, None) if self._preedit_visible else self._surrounding_text()
        result = _result(_lib.meltype_handle_key(
            self._session, vk, character, modifiers,
            before.encode() if before is not None else None,
            after.encode() if after is not None else None))
        if result is None:
            self._notify_caret_moved(vk, bool(modifiers & 2))
            return False
        self._apply(result)
        consumed = bool(result.get("consumed"))
        # アプリに通したキー (矢印・Tab・Ctrl など) はキャレットを動かすかもしれない。
        # コード行を日本語にしていたら、別の場所へ移った時点で英数に戻す。
        if not consumed:
            self._notify_caret_moved(vk, bool(modifiers & 2))
        return consumed

    def _notify_caret_moved(self, vk, control):
        """アプリに通したキーを本体へ伝える。日本語を解除する条件は本体だけで判断する。"""
        if not self._code_input or _caret_moved is None:
            return
        _caret_moved(self._session, vk, 1 if control else 0)

    def _finalize_on_focus_loss(self):
        """フォーカスが外れる・Reset のときの後始末。

        表示は確定される形にしてあるので、確定そのものは IBus が preedit から行う。ここで確定を
        送ると二重になる。ただし表示していないのに未確定が残っているときは、送らないと文字が消える。
        """
        if not self._session:
            return
        # 表示中の preedit は IBus がそのまま確定する。エンジンがここで送る文字はフォーカスが
        # 外れたあとで届かない (実 IBus で確認) うえ、届いても順序が壊れる (I love sushi gasuki で
        # がすき のあとに すし が入る)。直前の確定文字列への置換はあきらめ、本体の状態だけを
        # 「今の preedit を確定した」に進めて文書と合わせる (置換を混ぜたまま進めると、本体だけが
        # 直った前提になり、文書とずれる)。meltype_commit は結果を返すだけでなく本体の状態を
        # 進めるので、置換を無効にするのは**呼ぶ前**でなければならない (あとからでは取り消せない)。
        replacing = self._preedit_visible
        if replacing:
            _lib.meltype_set_can_delete(self._session, 0)
        edit = _result(_lib.meltype_commit(self._session))
        if replacing:
            _lib.meltype_set_can_delete(self._session, 1 if self._can_delete else 0)
            return
        if (edit or {}).get("commits"):
            self._apply(edit)

    def _switch_mode(self, keyval):
        """未確定の内容を確定してから、コード行なら日本語/英数を、そうでなければ直接入力を切り替える。"""
        self._apply(_result(_lib.meltype_commit(self._session)))
        before, _after = (None, None) if self._preedit_visible else self._surrounding_text()
        was_direct = self._direct
        if self._switch_code_mode(keyval, before):
            return
        to_direct = keyval in ALWAYS_DIRECT_KEYS or (keyval in ZENKAKU_HANKAKU_KEYS and not was_direct)
        self._direct = to_direct
        _lib.meltype_set_direct(self._session, 1 if to_direct else 0)

    def _switch_code_mode(self, keyval, before):
        """コード行の切り替えを扱ったら True。文字列・コメント内などは通常の切り替えに任せる。"""
        if not self._code_input or _set_code_line is None or _code_english_at is None:
            return False
        if self._direct:
            if keyval in ALWAYS_DIRECT_KEYS:
                return False
            self._direct = False
            _lib.meltype_set_direct(self._session, 0)
        before_utf8 = before.encode() if before is not None else None
        if keyval in ALWAYS_DIRECT_KEYS:
            _set_code_line(self._session, 0, before_utf8)
            # 英数・無変換は文字列内でも Direct にするため、通常の切り替えへ進む。
            return False
        # 英数のコード行なら日本語へ、それ以外なら明示的な日本語の解除を試す。
        # 文字列・コメント内でも 0 になるが、SetCodeLine が扱わなければ通常の切り替えへ進む。
        japanese = True
        if keyval in ZENKAKU_HANKAKU_KEYS:
            japanese = bool(_code_english_at(self._session, before_utf8))
        return bool(_set_code_line(self._session, 1 if japanese else 0, before_utf8))

    def _reset_code_japanese(self):
        """コード行の日本語をやめる (フォーカスが外れたとき)。"""
        if self._code_input and _set_code_line is not None:
            _set_code_line(self._session, 0, None)

    def do_focus_out(self):
        # 別の入力欄・アプリに移るときは、未確定の内容を確定する。
        self._finalize_on_focus_loss()
        self._reset_code_japanese()

    def do_set_capabilities(self, caps):
        # 周りの文字 (surrounding text) に対応していない入力欄では、確定済みの文字を消せない。
        # 消せないのに確定し直すと、元の文字が残ったまま書き足される (api → apiあぴ) ので、本体に確定し直しをやめさせる。
        self._can_delete = bool(caps & IBus.Capabilite.SURROUNDING_TEXT)
        if self._session:
            _lib.meltype_set_can_delete(self._session, 1 if self._can_delete else 0)

    def do_set_content_type(self, purpose, hints):
        # 入力欄がターミナル (GNOME Terminal の VTE や Ghostty などは input-purpose: terminal を設定する) なら、
        # コード入力を既定にする。j k やコマンド名が変換中の文字に入って、アプリに届かなくなるのを防ぐ
        # (Windows 版でターミナルが既定で「コード」なのと同じ)。
        # コード行は 半角/全角 で日本語にできる (下の _switch_mode)。
        if not self._session:
            return
        # 切り替え・状態問い合わせの両方がある本体でだけ有効にする。古い本体では通常の IME 切り替えを使う。
        code_input = (purpose == IBus.InputPurpose.TERMINAL and _set_code_input is not None
                      and _set_code_line is not None and _code_english_at is not None)
        if code_input != self._code_input:
            # 変わったときだけ本体へ伝える。同じ値で meltype_set_code_input を呼ぶと本体が行の追跡と日本語の指定を
            # 初期化してしまうので、変わらない再通知では呼ばない。別の種類の入力欄へ移ったら初期化する。
            self._code_input = code_input
            if _set_code_input is not None:
                _set_code_input(self._session, 1 if code_input else 0)
            if code_input and self._direct:
                self._direct = False
                _lib.meltype_set_direct(self._session, 0)
        if _set_code_terminal is not None:
            _set_code_terminal(self._session, 1 if code_input else 0)

    def do_focus_in(self):
        self.register_properties(self._properties)

    def do_property_activate(self, prop_name, state):
        if prop_name == "report":
            try:
                subprocess.Popen(["xdg-open", _report_url()])
            except OSError as error:
                print(f"Meltype: 報告の画面を開けませんでした: {error}", file=sys.stderr)

    def do_reset(self):
        # Reset でも IBus は「表示中の preedit」を確定する。表示は確定される形にしてある。
        # コード行の日本語は Reset では消さない (Enter のたびに Reset が来るクライアントで、
        # 続けて日本語を打てなくなるため。フォーカスが外れたときは do_focus_out で消す)。
        self._finalize_on_focus_loss()
        self._hide_preedit()
        self._hide_candidates()

    def do_disable(self):
        self.do_focus_out()

    def do_candidate_clicked(self, index, button, state):
        if not self._session:
            return
        page = self._lookup.get_cursor_pos() // self._lookup.get_page_size()
        self._apply(_result(_lib.meltype_select_candidate(self._session, page * self._lookup.get_page_size() + index)))

    def do_destroy(self):
        if self._session:
            _lib.meltype_destroy(self._session)
            self._session = None
        IBus.Engine.do_destroy(self)

    # 結果を入力欄に出す

    def _apply(self, result):
        if not result:
            return
        for edit in result.get("commits", []):
            delete_before = edit.get("deleteBefore", 0)
            # 確定し直し: 消す文字が今もキャレットの前にあると確認できたときだけ消し、今打った文字を入れる。
            # 確認できない (入力欄が周りの文字に対応していない・確定したときと変わった) ときは、前の文字は
            # 消さずに今打った文字だけを入れる (本体は text が入った前提で状態を進めるので、text を捨てない)。
            length = self._expected_before_caret(edit.get("expect")) if delete_before > 0 else 0
            if delete_before > 0 and not length:
                print("Meltype: 確定し直す文字を確認できないため、前の文字を消しません", file=sys.stderr)
            # 消すだけの preedit 更新を確定の前に送らない。Chromium 系 (Wayland text-input-v3) は
            # それを変換中の文字の確定と解釈して挿入し (issue #486 と同じ問題)、確定し直しでは
            # さらに続く削除の位置がずれて壊れる。変換中の表示を消すのは確定のあと (下の else)。
            # surrounding の削除は変換中の文字には触れないので、表示を消す前に消してよい。
            if length:
                # キャレットの前の文字を消してから入れる (入力欄が対応していれば)。
                # 消えたかどうかは送ったあとでしか分からないので、次の入力のときに確かめる
                # (Wayland + Chromium は削除要求を無視するため、前の文字が残って二重になる)。
                self._note_replace(length, edit.get("text") or "")
                self.delete_surrounding_text(-length, length)
            if edit.get("text"):
                self.commit_text(IBus.Text.new_from_string(edit["text"]))
        view = result.get("view")
        if view:
            self._show_preedit(view)
            self._show_candidates(view)
        else:
            self._hide_preedit()
            self._hide_candidates()

    def _expected_before_caret(self, expected):
        """キャレットの前が expected と一致すると確認できたら、消す文字数 (コードポイント) を返す。確認できないときは 0。"""
        if not isinstance(expected, str) or not expected:
            return 0
        try:
            text, cursor, _anchor = self.get_surrounding_text()
            value = text.get_text() if text else ""
        except Exception as error:
            print(f"Meltype: 確定し直す文字を確認できませんでした: {error}", file=sys.stderr)
            return 0
        # IBus は文字 (コードポイント) 単位。本体の deleteBefore (UTF-16) ではなく、確認できた文字列から数える
        # (絵文字など、2 単位の文字でもそろえる)。
        length = len(expected)
        if not (0 <= cursor <= len(value) and cursor >= length) or value[cursor - length:cursor] != expected:
            return 0
        return length

    def _show_preedit(self, view):
        # IBus は「表示中の preedit」をそのまま確定する (COMMIT モード)。表示と確定が違うと、
        # フォーカスが外れたときに「かn」が入って本体の「かん」とずれるので、確定される形を出す。
        text = view.get("committed") or view.get("text", "")
        attributes = IBus.AttrList()
        clauses = view.get("clauses") or []
        if view.get("converting") and clauses:
            # 変換中: 文節ごとに下線。選んでいる文節は背景を付ける。
            position = 0
            for index, clause in enumerate(clauses):
                end = position + len(clause)
                attributes.append(IBus.attr_underline_new(IBus.AttrUnderline.SINGLE, position, end))
                if index == view.get("selectedClause", -1):
                    attributes.append(IBus.attr_background_new(0x4CA0FF, position, end))
                    attributes.append(IBus.attr_foreground_new(0xFFFFFF, position, end))
                position = end
        elif text:
            attributes.append(IBus.attr_underline_new(IBus.AttrUnderline.SINGLE, 0, len(text)))
        preedit = IBus.Text.new_from_string(text)
        preedit.set_attributes(attributes)
        # フォーカスが外れたら、変換中の文字をそのまま確定する (COMMIT)。
        self.update_preedit_text_with_mode(preedit, len(text), bool(text), IBus.PreeditFocusMode.COMMIT)
        self._preedit_visible = bool(text)
        self._preedit_text = text
        # 案内 (Space で変換 など) は補助テキストに出す
        hint = view.get("hint") or ""
        # もしかして (書き間違い) は案内の先頭に出す (Tab で直せる)
        if view.get("suggestion"):
            hint = view["suggestion"] + "　" + hint
        if hint:
            self.update_auxiliary_text(IBus.Text.new_from_string(hint), True)
        else:
            self.hide_auxiliary_text()

    def _hide_preedit(self):
        if self._preedit_visible:
            self.update_preedit_text_with_mode(IBus.Text.new_from_string(""), 0, False, IBus.PreeditFocusMode.CLEAR)
            self._preedit_visible = False
            self._preedit_text = ""
        self.hide_auxiliary_text()

    def _show_candidates(self, view):
        candidates = view.get("candidates") or []
        if not (view.get("converting") and len(candidates) > 1):
            self._hide_candidates()
            return
        if candidates != self._candidates:
            self._lookup.clear()
            for candidate in candidates:
                self._lookup.append_candidate(IBus.Text.new_from_string(candidate))
            self._candidates = candidates
        selected = view.get("selectedIndex", 0)
        if 0 <= selected < len(candidates):
            self._lookup.set_cursor_pos(selected)
        self.update_lookup_table(self._lookup, True)
        self._schedule_meaning(view)

    def _schedule_meaning(self, view):
        meaning = view.get("meaning")
        key = f"{view.get('selectedIndex')}:{meaning}" if meaning else None
        if key == self._meaning_key:
            return
        self._meaning_key = key
        if key is None:
            return

        def show():
            if self._meaning_key == key and self._candidates:
                self.update_auxiliary_text(IBus.Text.new_from_string(meaning), True)
            return False

        GLib.timeout_add(1500, show)

    def _hide_candidates(self):
        self._meaning_key = None
        if self._candidates:
            self._lookup.clear()
            self._candidates = []
        self.hide_lookup_table()

    def _surrounding_text(self):
        """入力欄のキャレットの前後の文字列 (それぞれ 20 文字まで)。入力欄が対応していなければ (None, None)。"""
        try:
            text, cursor, _anchor = self.get_surrounding_text()
            value = text.get_text() if text else ""
            if not value:
                return None, None
            return value[max(0, cursor - 20):cursor], value[cursor:cursor + 20]
        except Exception:
            return None, None

    def _surrounding_value(self):
        """入力欄に入っている文字列とキャレットの位置 (取り出せなければ None)。"""
        try:
            text, cursor, _anchor = self.get_surrounding_text()
            return ((text.get_text() if text else ""), cursor)
        except Exception:
            return None

    def _note_replace(self, count, text):
        """確定し直しのあと、実際に入力欄から消えているかを、次の入力のときに確かめる。

        Wayland + Chromium では delete_surrounding_text が無視されることがあり、その場合は
        前の語が残ったまま書き足されて文書が壊れる (I love sushi すしがすき)。消えたかどうかは
        送ったあとでしか分からないので、ここで期待する文字列を控えておく。
        """
        self._replace_expect = None
        surrounding = self._surrounding_value()
        if surrounding is None:
            return
        value, cursor = surrounding
        if cursor < count:
            return
        self._replace_expect = value[:cursor - count] + text

    def _check_replace(self):
        """前回の確定し直しが実際に効いていたかを確かめる。効いていなければ以降はやめる。"""
        expected, self._replace_expect = self._replace_expect, None
        if expected is None or not self._session:
            return
        surrounding = self._surrounding_value()
        if surrounding is None:
            return
        value, cursor = surrounding
        if value[:cursor] == expected:
            return
        _lib.meltype_set_can_delete(self._session, 0)
        print("Meltype: この入力欄は文字を消せないため、確定し直しをやめます "
              f"(期待 {expected!r} / 実際 {value[:cursor]!r})", file=sys.stderr)


# ---- 起動 ----

def main():
    IBus.init()
    bus = IBus.Bus()
    if not bus.is_connected():
        print("Meltype: IBus につながりません", file=sys.stderr)
        sys.exit(1)
    loop = GLib.MainLoop()
    # IBus が終わったら (ログアウト・ibus restart) 一緒に終わる
    bus.connect("disconnected", lambda *_: loop.quit())
    factory = IBus.Factory.new(bus.get_connection())
    factory.add_engine("meltype", GObject.type_from_name("MeltypeEngine"))
    if "--ibus" in sys.argv:
        bus.request_name("org.freedesktop.IBus.Meltype", 0)
    else:
        # 手で起動したとき (試すとき): コンポーネントを登録する
        component = IBus.Component.new("org.freedesktop.IBus.Meltype", "Meltype", "1.2.2-pre.2", "GPL-3.0-or-later", "Yukishiro", "https://github.com/yksr-melt/Meltype", "", "")
        component.add_engine(IBus.EngineDesc.new("meltype", "Meltype", "Meltype", "ja", "GPL-3.0-or-later", "Yukishiro", "", "default"))
        bus.register_component(component)
    loop.run()


if __name__ == "__main__":
    main()
