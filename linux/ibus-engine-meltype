# Meltype の Linux 版 (IBus の入力エンジン)。IBus から読んだ事実 (キー・キャレットの前後の文字・入力欄の種類) を
# 本体 (libMeltypeNative.so の ImeHost) に渡し、返ってきた指示 (確定・変換中の表示・候補・入力モードの表示) を入力欄に出す。
# 入力モードとモードを切り替えるキーの意味は本体が決めるので、ここでは持たない。漢字変換は Mozc の変換ヘルパーを本体が呼ぶ。
#   ibus-engine-meltype --ibus   IBus から起動されるとき (コンポーネントの <exec>)
#   ibus-engine-meltype --version  版だけを出して終わる
import ctypes
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))

_lib = ctypes.CDLL(os.path.join(HERE, "libMeltypeNative.so"))
_lib.meltype_free.argtypes = [ctypes.c_void_p]
_lib.meltype_version.restype = ctypes.c_void_p
_lib.meltype_report_url.argtypes = [ctypes.c_char_p]
_lib.meltype_report_url.restype = ctypes.c_void_p
_lib.meltype_init.argtypes = [ctypes.c_char_p, ctypes.c_void_p]
_lib.meltype_init.restype = ctypes.c_int
_lib.meltype_set_conversion_ready.argtypes = [ctypes.CFUNCTYPE(None)]
_lib.meltype_set_conversion_ready.restype = None
_lib.meltype_ime_create.restype = ctypes.c_void_p
_lib.meltype_ime_handle.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
_lib.meltype_ime_handle.restype = ctypes.c_void_p
_lib.meltype_ime_destroy.argtypes = [ctypes.c_void_p]

# 本体のプロトコルの版 (ImeHost.Version)
IME_VERSION = 1


def _take(pointer):
    """本体が返した文字列を読んで解放する。NULL なら None。"""
    if not pointer:
        return None
    try:
        return ctypes.string_at(pointer).decode("utf-8")
    finally:
        _lib.meltype_free(pointer)


if "--version" in sys.argv[1:]:
    version = _take(_lib.meltype_version())
    if not version or not version.strip():
        print("Meltype: 本体の版を取得できません", file=sys.stderr)
        raise SystemExit(1)
    print(f"Meltype {version}")
    raise SystemExit(0)

import gi

gi.require_version("IBus", "1.0")
from gi.repository import GLib, GObject, IBus  # noqa: E402

# 英単語の判定は同梱の一覧 (None)
if not _lib.meltype_init(HERE.encode(), None):
    print("Meltype: Mozc を使えません (漢字変換はひらがなのままになります)", file=sys.stderr)

# 最後にフォーカスを受けたエンジン。背景の変換の結果が届いたら、この入力欄の表示を作り直す
_focused = None


def _refresh_focused():
    if _focused is not None:
        _focused.send("ConversionFinished")
    return False


# ワーカーのスレッドで呼ばれるので、メインループに移す。ctypes の関数オブジェクトはプロセスが終わるまで持つ
_conversion_ready = ctypes.CFUNCTYPE(None)(lambda: GLib.idle_add(_refresh_focused) and None)
_lib.meltype_set_conversion_ready(_conversion_ready)


def _report_url():
    """不具合報告を開く URL (OS・版・実行環境を入れたもの)。"""
    return _take(_lib.meltype_report_url(b"Linux")) or "https://github.com/yksr-melt/Meltype/issues/new/choose"


# ---- キー: 文字の無いキー (keyval) → 本体が使う Windows の仮想キーコード。文字を入力するキーは文字だけを渡す ----

SPECIAL_KEYS = {
    IBus.KEY_Return: 0x0D, IBus.KEY_KP_Enter: 0x0D, IBus.KEY_Tab: 0x09, IBus.KEY_ISO_Left_Tab: 0x09,
    IBus.KEY_space: 0x20,
    IBus.KEY_BackSpace: 0x08, IBus.KEY_Delete: 0x2E, IBus.KEY_Escape: 0x1B,
    IBus.KEY_Left: 0x25, IBus.KEY_Up: 0x26, IBus.KEY_Right: 0x27, IBus.KEY_Down: 0x28,
    IBus.KEY_Home: 0x24, IBus.KEY_End: 0x23, IBus.KEY_Page_Up: 0x21, IBus.KEY_Page_Down: 0x22,
    # NumLock を切ったテンキー (Windows と同じく、専用のキーと同じにする。PageUp の無いキーボードで候補のページを送れる)
    IBus.KEY_KP_Left: 0x25, IBus.KEY_KP_Up: 0x26, IBus.KEY_KP_Right: 0x27, IBus.KEY_KP_Down: 0x28,
    IBus.KEY_KP_Home: 0x24, IBus.KEY_KP_End: 0x23, IBus.KEY_KP_Page_Up: 0x21, IBus.KEY_KP_Page_Down: 0x22, IBus.KEY_KP_Delete: 0x2E,
    IBus.KEY_F6: 0x75, IBus.KEY_F7: 0x76, IBus.KEY_F8: 0x77, IBus.KEY_F9: 0x78, IBus.KEY_F10: 0x79,
    # 入力モードのキー (意味は本体が決める)
    IBus.KEY_Zenkaku_Hankaku: 0x19, IBus.KEY_Hankaku: 0x19, IBus.KEY_Zenkaku: 0x19,
    IBus.KEY_Eisu_toggle: 0xF0, IBus.KEY_Hiragana_Katakana: 0x15, IBus.KEY_Henkan: 0x1C, IBus.KEY_Muhenkan: 0x1D,
}


# テンキーの数字・記号の仮想キーコード (Windows の VK_NUMPAD0〜9・VK_MULTIPLY など)。文字と一緒に渡す。
# 本体は、何も打っていないときのテンキーをそのまま通す (上の段の数字とは分ける: issue #460)
KEYPAD_KEYS = {
    **{getattr(IBus, f"KEY_KP_{n}"): 0x60 + n for n in range(10)},
    IBus.KEY_KP_Multiply: 0x6A, IBus.KEY_KP_Add: 0x6B, IBus.KEY_KP_Separator: 0x6C,
    IBus.KEY_KP_Subtract: 0x6D, IBus.KEY_KP_Decimal: 0x6E, IBus.KEY_KP_Divide: 0x6F,
}


def virtual_key(keyval):
    """(仮想キーコード, 入力する文字) を返す。文字を入力するキーの仮想キーコードは 0 (本体が文字から決める。テンキーだけは文字と一緒に渡す)。
    Meltype が扱わないキーなら (None, 0)。"""
    if keyval in SPECIAL_KEYS:
        return SPECIAL_KEYS[keyval], (0x20 if keyval == IBus.KEY_space else 0)
    character = IBus.keyval_to_unicode(keyval)
    # 空・複数スカラー・制御文字は渡さない (先頭 1 文字へ黙って切り詰めない)。
    if not character or len(character) != 1 or ord(character) < 0x20:
        return None, 0
    return KEYPAD_KEYS.get(keyval, 0), ord(character)


# 判定の文脈とコードの行の判定に使う、キャレットの前の文字数
BEFORE_LENGTH = 4000
AFTER_LENGTH = 20

# 矢印キー (←) のキーコード (確定したあとにキャレットを戻す)
KEYCODE_LEFT = 105


# ---- 入力エンジン ----

# 入力の本体 (ImeHost)。IBus は入力欄ごとにエンジンを作るが、入力モードはすべての入力欄で同じにするので、プロセスで 1 つにする
_host = None


def _shared_host():
    global _host
    if not _host:
        _host = _lib.meltype_ime_create()
    return _host


class MeltypeEngine(IBus.Engine):
    __gtype_name__ = "MeltypeEngine"

    def __init__(self):
        super().__init__()
        self._preedit_visible = False
        # 入力欄の事実 (IBus が知らせてくる)
        self._surrounding = True
        self._traits = []
        self._app = None
        # どの入力欄にもフォーカスが無いとき、IBus は仮の入力コンテキスト (クライアント名「fake」) にフォーカスを移す
        self._fake = False
        # 確定し直しで前の文字を消したのに残っていた入力欄 (Wayland + Chromium) は、これからも消せないとみなす
        self._delete_failed = False
        self._replace_expect = None
        self._lookup = IBus.LookupTable.new(9, 0, True, True)
        self._lookup.set_orientation(IBus.Orientation.VERTICAL)
        self._candidates = []
        # 候補で少し (1.5 秒) 止まったら、その候補の意味を補助テキストに出す (Windows 版と同じ)
        self._meaning_key = None
        self._mode_shown = None
        # 入力欄に入ったときの入力モードの表示 (あ / A, 時間)。入ったあとアプリがキャレットの位置を知らせてから出す
        self._defer_mode = False
        self._pending_mode = None
        self._properties = IBus.PropList()
        # パネルの「あ / A」(GNOME などは key が InputMode のプロパティの symbol を出す)。本体が最後に返した言語モードを出す
        self._language_mode = None
        self._mode_property = IBus.Property(key="InputMode", prop_type=IBus.PropType.NORMAL, label=IBus.Text.new_from_string("あ"),
                                            symbol=IBus.Text.new_from_string("あ"), sensitive=False, visible=True)
        self._properties.append(self._mode_property)
        self._properties.append(IBus.Property.new(
            "report", IBus.PropType.NORMAL, IBus.Text.new_from_string("不具合の報告・提案… (Linux 版はプレビュー版です)"),
            "", IBus.Text.new_from_string(""), True, True, IBus.PropState.UNCHECKED, IBus.PropList()))

    # ---- 本体とのやり取り ----

    def send(self, event_type, **fields):
        """出来事を本体に送り、返ってきた指示を入力欄に出す。応答 (ImeOutput) を返す。本体が処理できなければ None。"""
        host = _shared_host()
        if not host:
            return None
        self._check_replace()
        event = {"version": IME_VERSION, "type": event_type, "instance": "ibus", "field": self._field(), **fields}
        reply = _take(_lib.meltype_ime_handle(host, json.dumps(event).encode()))
        if reply is None:
            return None
        output = json.loads(reply)
        self._apply(output["result"])
        if output["state"]["languageMode"] != self._language_mode:
            self._language_mode = output["state"]["languageMode"]
            label = IBus.Text.new_from_string("あ" if self._language_mode == "Japanese" else "A")
            self._mode_property.set_label(label)
            self._mode_property.set_symbol(label)
            self.update_property(self._mode_property)
        if output["state"]["modeIndicatorMs"]:
            mode = (output["state"]["languageMode"] == "Japanese", output["state"]["modeIndicatorMs"])
            if self._defer_mode:
                self._pending_mode = mode
            else:
                self._show_mode(*mode)
        return output

    def do_set_cursor_location(self, x, y, w, h):
        if self._pending_mode:
            mode, self._pending_mode = self._pending_mode, None
            self._show_mode(*mode)

    def _field(self):
        before, after, selection = self._surrounding_text()
        traits = self._traits + (["NonText"] if self._fake else [])
        field = {"before": before, "after": after, "composing": self._preedit_visible, "traits": traits,
                 "canRemove": self._surrounding and not self._delete_failed}
        if selection:
            field["selection"] = selection
        if self._app:
            field["app"] = self._app
        return field

    # ---- IBus からの呼び出し ----

    def do_process_key_event(self, keyval, keycode, state):
        if state & IBus.ModifierType.RELEASE_MASK:
            return False
        vk, character = virtual_key(keyval)
        if vk is None:
            return False
        key = {"vk": vk, "ch": character,
               "shift": bool(state & IBus.ModifierType.SHIFT_MASK), "ctrl": bool(state & IBus.ModifierType.CONTROL_MASK),
               "alt": bool(state & IBus.ModifierType.MOD1_MASK),
               "command": bool(state & (IBus.ModifierType.SUPER_MASK | IBus.ModifierType.MOD4_MASK))}
        output = self.send("KeyPressed", key=key)
        return bool(output and output["result"]["consumed"])

    def _leave(self, focus_out):
        """フォーカスが外れる・Reset (クリックなど)。キャレットはこの入力欄の外か、クリックした所に移る。

        表示中の preedit は IBus がそのまま確定する (COMMIT モード)。エンジンがここで送る文字はフォーカスが外れたあとで
        届かないうえ、届いても順序が壊れるので、本体には「表示のまま確定された」と伝える。
        """
        caret = {"moved": True, "passedKey": 0, "focusLeft": focus_out}
        if self._preedit_visible:
            self._preedit_visible = False
            self.send("CommittedByApp", caret=caret)
        else:
            self.send("CommitRequested", caret=caret)

    def do_focus_in_id(self, object_path, client):
        # IBus 1.5.27 以降。client は「gtk4-im:gnome-text-editor」のように、IM モジュールとプログラムの名前。
        # GNOME Shell の画面は「gnome-shell」だけ。仮の入力コンテキストは「fake」で、入力欄ではない
        self._fake = client == "fake"
        self._app = None if self._fake else client.rpartition(":")[2] or None
        self.do_focus_in()

    def do_focus_in(self):
        global _focused
        _focused = self
        self.register_properties(self._properties)
        self._defer_mode = True
        try:
            self.send("CaretMoved", caret={"moved": True, "passedKey": 0, "focusEntered": True})
        finally:
            self._defer_mode = False

    def do_focus_out(self):
        self._pending_mode = None
        self._leave(focus_out=True)

    def do_reset(self):
        # Reset は Enter のたびに来るクライアントがあるので、日本語にしていたコードの行はそのまま
        self._leave(focus_out=False)
        self._hide_preedit()
        self._hide_candidates()

    def do_disable(self):
        self._leave(focus_out=True)

    def do_set_capabilities(self, caps):
        self._surrounding = bool(caps & IBus.Capabilite.SURROUNDING_TEXT)

    def do_set_content_type(self, purpose, hints):
        # GNOME Terminal の VTE や Ghostty などは input-purpose: terminal を設定する
        self._traits = [trait for trait, present in (
            ("Terminal", purpose == IBus.InputPurpose.TERMINAL),
            ("Password", purpose in (IBus.InputPurpose.PASSWORD, IBus.InputPurpose.PIN)),
            # 古い IBus (RHEL 9 のもの) には InputHints.PRIVATE が無い
            ("Private", bool(hints & getattr(IBus.InputHints, "PRIVATE", 0))),
        ) if present]

    def do_candidate_clicked(self, index, button, state):
        page = self._lookup.get_cursor_pos() // self._lookup.get_page_size()
        self.send("CandidateClicked", index=page * self._lookup.get_page_size() + index)

    def do_property_activate(self, prop_name, state):
        if prop_name == "report":
            try:
                subprocess.Popen(["xdg-open", _report_url()])
            except OSError as error:
                print(f"Meltype: 報告の画面を開けませんでした: {error}", file=sys.stderr)

    def do_destroy(self):
        global _focused
        if _focused is self:
            _focused = None
        IBus.Engine.do_destroy(self)

    # ---- 指示を入力欄に出す ----

    def _apply(self, result):
        for edit in result["commits"]:
            # 確定し直し: 本体がキャレットの前と照合した前の文字 (removeBefore) を消してから入れる
            if edit["removeBefore"] is not None:
                # IBus は文字 (コードポイント) 単位で消す。消えたかどうかは送ったあとでしか分からないので、次の出来事のときに確かめる
                length = len(edit["removeBefore"])
                self._note_replace(length, edit["text"])
                self.delete_surrounding_text(-length, length)
            # 消すだけの preedit 更新を確定の前に送らない。Chromium 系 (Wayland text-input-v3) は
            # それを変換中の文字の確定と解釈して挿入する (issue #486)。変換中の表示を消すのは確定のあと (下の else)
            if edit["text"]:
                self.commit_text(IBus.Text.new_from_string(edit["text"]))
            # 確定した文字の中にキャレットを戻す (空の括弧の中など)。IBus からキャレットは動かせないので、← をアプリに送る
            for _ in range(edit["moveCaretBack"]):
                self.forward_key_event(IBus.KEY_Left, KEYCODE_LEFT, 0)
                self.forward_key_event(IBus.KEY_Left, KEYCODE_LEFT, IBus.ModifierType.RELEASE_MASK)
        view = result["view"]
        if view:
            self._show_preedit(view)
            self._show_candidates(view)
        else:
            self._hide_preedit()
            self._hide_candidates()

    def _show_preedit(self, view):
        text = view["text"]
        attributes = IBus.AttrList()
        clauses = view["clauses"]
        if view["converting"] and clauses:
            # 変換中: 文節ごとに下線。選んでいる文節は背景を付ける。
            position = 0
            for index, clause in enumerate(clauses):
                end = position + len(clause)
                attributes.append(IBus.attr_underline_new(IBus.AttrUnderline.SINGLE, position, end))
                if index == view["selectedClause"]:
                    attributes.append(IBus.attr_background_new(0x4CA0FF, position, end))
                    attributes.append(IBus.attr_foreground_new(0xFFFFFF, position, end))
                position = end
        elif text:
            attributes.append(IBus.attr_underline_new(IBus.AttrUnderline.SINGLE, 0, len(text)))
        preedit = IBus.Text.new_from_string(text)
        preedit.set_attributes(attributes)
        # IBus は「表示中の preedit」をそのまま確定する (COMMIT モード)。本体は確定される形を出すので、本体の確定と同じになる
        self.update_preedit_text_with_mode(preedit, len(text), bool(text), IBus.PreeditFocusMode.COMMIT)
        self._preedit_visible = bool(text)
        # 打ったキー・もしかして (書き間違い。Tab で直せる)・案内を、補助テキストに 1 行で出す
        aux = "　".join(part for part in (view["typedKeys"], view["spellingSuggestion"], view["hint"]) if part)
        if aux:
            self.update_auxiliary_text(IBus.Text.new_from_string(aux), True)
        else:
            self.hide_auxiliary_text()

    def _hide_preedit(self):
        if self._preedit_visible:
            self.update_preedit_text_with_mode(IBus.Text.new_from_string(""), 0, False, IBus.PreeditFocusMode.CLEAR)
            self._preedit_visible = False
        self.hide_auxiliary_text()

    def _show_mode(self, japanese, milliseconds):
        """入力モードを切り替えたとき、補助テキストに「あ / A」を本体が決めた時間だけ出す。"""
        token = object()
        self._mode_shown = token
        self.update_auxiliary_text(IBus.Text.new_from_string("あ" if japanese else "A"), True)

        def hide():
            if self._mode_shown is token and not self._preedit_visible:
                self.hide_auxiliary_text()
            return False

        GLib.timeout_add(milliseconds, hide)

    def _show_candidates(self, view):
        listed = view["candidates"]
        if not listed:
            self._hide_candidates()
            return
        # 注記 (候補の種類など) は候補の後ろに付ける
        candidates = [item + ("　" + note if note else "") for item, note in zip(listed["items"], listed["notes"])]
        if candidates != self._candidates:
            self._lookup.clear()
            for candidate in candidates:
                self._lookup.append_candidate(IBus.Text.new_from_string(candidate))
            self._candidates = candidates
        # 番号は本体が決める (数字キーで選べる一覧だけ)。空のラベルなら IBus のパネルは番号を出さない
        for index in range(self._lookup.get_page_size()):
            label = f"{index + 1}." if listed["numbered"] else ""
            self._lookup.set_label(index, IBus.Text.new_from_string(label))
        selected = listed["selected"]
        if 0 <= selected < len(candidates):
            self._lookup.set_cursor_pos(selected)
        self.update_lookup_table(self._lookup, True)
        self._schedule_meaning(listed)

    def _schedule_meaning(self, listed):
        meaning = listed["selectedMeaning"]
        key = f"{listed['selected']}:{meaning}" if meaning else None
        if key == self._meaning_key:
            return
        self._meaning_key = key
        if key is None:
            return

        def show():
            if self._meaning_key == key and self._candidates:
                self.update_auxiliary_text(IBus.Text.new_from_string(meaning), True)
            return False

        GLib.timeout_add(listed["meaningDelayMs"], show)

    def _hide_candidates(self):
        self._meaning_key = None
        if self._candidates:
            self._lookup.clear()
            self._candidates = []
        self.hide_lookup_table()

    # ---- 入力欄の文字 ----

    def _surrounding_value(self):
        """入力欄の確定した文字列とキャレットの位置。入力欄が対応していない・読めなければ None。

        IBus は、クライアントが周辺の文字を送ってこないときも空の文字列を返すので、空は入力欄の先頭と見分けられない (None にする)。
        """
        if not self._surrounding:
            return None
        try:
            text, cursor, _anchor = self.get_surrounding_text()
        except Exception:
            return None
        value = text.get_text() if text else ""
        return (value, cursor) if value else None

    def _surrounding_text(self):
        """選んでいる文字の前・後ろの文字列と、選んでいる文字。読めなければ (None, None, None)。"""
        if not self._surrounding:
            return None, None, None
        try:
            text, cursor, anchor = self.get_surrounding_text()
        except Exception:
            return None, None, None
        value = text.get_text() if text else ""
        if not value:
            return None, None, None
        start, end = min(cursor, anchor), max(cursor, anchor)
        return value[max(0, start - BEFORE_LENGTH):start], value[end:end + AFTER_LENGTH], value[start:end]

    def _note_replace(self, count, text):
        """確定し直しのあと、実際に入力欄から消えているかを、次の入力のときに確かめるために期待する文字列を控える。"""
        self._replace_expect = None
        surrounding = self._surrounding_value()
        if surrounding is None:
            return
        value, cursor = surrounding
        if cursor >= count:
            self._replace_expect = value[:cursor - count] + text

    def _check_replace(self):
        """前回の確定し直しが実際に効いていたかを確かめる。効いていなければ、この入力欄は消せないと本体に伝える。
        入力欄の文字を読めなければ、次に読めるときまで確かめるのを待つ。
        """
        expected = self._replace_expect
        if expected is None:
            return
        surrounding = self._surrounding_value()
        if surrounding is None:
            return
        self._replace_expect = None
        value, cursor = surrounding
        if value[:cursor] == expected:
            return
        self._delete_failed = True
        print("Meltype: この入力欄は文字を消せないため、確定し直しをやめます "
              f"(期待 {expected!r} / 実際 {value[:cursor]!r})", file=sys.stderr)


# ---- 起動 ----

def main():
    IBus.init()
    bus = IBus.Bus()
    if not bus.is_connected():
        print("Meltype: IBus につながりません", file=sys.stderr)
        sys.exit(1)
    loop = GLib.MainLoop()
    # IBus が終わったら (ログアウト・ibus restart) 一緒に終わる
    bus.connect("disconnected", lambda *_: loop.quit())
    factory = IBus.Factory.new(bus.get_connection())
    factory.add_engine("meltype", GObject.type_from_name("MeltypeEngine"))
    if "--ibus" in sys.argv:
        bus.request_name("org.freedesktop.IBus.Meltype", 0)
    else:
        # 手で起動したとき (試すとき): コンポーネントを登録する
        component = IBus.Component.new("org.freedesktop.IBus.Meltype", "Meltype", "1.2.2-pre.2", "GPL-3.0-or-later", "Yukishiro", "https://github.com/yksr-melt/Meltype", "", "")
        component.add_engine(IBus.EngineDesc.new("meltype", "Meltype", "Meltype", "ja", "GPL-3.0-or-later", "Yukishiro", "", "default"))
        bus.register_component(component)
    loop.run()


if __name__ == "__main__":
    main()
