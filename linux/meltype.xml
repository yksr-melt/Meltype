<?xml version="1.0" encoding="utf-8"?>
<!-- build.sh が @VERSION@ を本体の版に、install.sh が @DIR@ をインストール先に置き換える。 -->
<component>
    <name>org.freedesktop.IBus.Meltype</name>
    <description>Meltype: 半角/全角 を押さずに日本語と英語を打ち分ける日本語入力</description>
    <exec>@DIR@/ibus-engine-meltype --ibus</exec>
    <version>@VERSION@</version>
    <author>Yukishiro</author>
    <license>GPL-3.0-or-later</license>
    <homepage>https://github.com/yksr-melt/Meltype</homepage>
    <textdomain>meltype</textdomain>
    <engines>
        <engine>
            <name>meltype</name>
            <language>ja</language>
            <license>GPL-3.0-or-later</license>
            <author>Yukishiro</author>
            <icon>@DIR@/icon.png</icon>
            <layout>default</layout>
            <longname>Meltype</longname>
            <description>半角/全角 を押さずに日本語と英語を打ち分ける日本語入力</description>
            <rank>0</rank>
            <symbol>あ</symbol>
        </engine>
    </engines>
</component>
