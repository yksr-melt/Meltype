# Maintainer: (未定。AUR に出すときに決める)
# meltype-bin: リリースの zip を置くだけのパッケージ (ビルドなし)。
# 版を上げるときは pkgver と sha256sums を更新して、makepkg --printsrcinfo > .SRCINFO を実行する。
pkgname=meltype-bin
pkgver=1.3.0
pkgrel=1
pkgdesc='雪解けのように、半角/全角の壁を溶かす日本語入力 (IBus / fcitx5)'
arch=('x86_64' 'aarch64')
url='https://github.com/yksr-melt/Meltype'
license=('GPL-3.0-or-later')
depends=('glibc' 'gcc-libs' 'zlib' 'python')
optdepends=(
    'ibus: IBus で使う'
    'python-gobject: IBus で使う'
    'fcitx5: fcitx5 で使う'
)
provides=('meltype')
conflicts=('meltype' 'meltype-ut')
install=meltype-bin.install
source_x86_64=("Meltype-${pkgver}-linux.zip::${url}/releases/download/v${pkgver}/Meltype-${pkgver}-linux.zip")
source_aarch64=("Meltype-${pkgver}-linux-arm64.zip::${url}/releases/download/v${pkgver}/Meltype-${pkgver}-linux-arm64.zip")
sha256sums_x86_64=('284ee5729975df2de9ed4fd7d5f5b22b0982db7c5a4f2186bb01d5bac835e736')
sha256sums_aarch64=('7fc9a0c72dc02009b9f74dff03bd6655d103e1ebe58f1355080cacbf2dd2a7e1')

package() {
    local dir='Meltype-linux'
    install -d "$pkgdir/opt/meltype"
    cp -a "$dir"/. "$pkgdir/opt/meltype/"
    # パッケージには要らないもの (手で入れる人向けの説明と、拡張子 .pyc)
    # /opt に残さないもの (fcitx5 の部品と IBus の定義は下で /usr に置く。.deb と同じ形)
    rm -rf "$pkgdir/opt/meltype/__pycache__" \
           "$pkgdir/opt/meltype/install.sh" \
           "$pkgdir/opt/meltype/uninstall.sh" \
           "$pkgdir/opt/meltype/はじめにお読みください.txt" \
           "$pkgdir/opt/meltype/meltype.xml" \
           "$pkgdir/opt/meltype/fcitx5"

    # IBus のコンポーネント (install.sh と同じく @DIR@ をインストール先に置き換える)
    sed "s|@DIR@|/opt/meltype|g" "$dir/meltype.xml" > meltype.xml
    install -Dm644 meltype.xml "$pkgdir/usr/share/ibus/component/meltype.xml"

    # fcitx5 のアドオン (zip に入っているときだけ)
    if [[ -f "$dir/fcitx5/meltype.so" ]]; then
        install -Dm755 "$dir/fcitx5/meltype.so" "$pkgdir/usr/lib/fcitx5/meltype.so"
        install -Dm644 "$dir/fcitx5/meltype-addon.conf" "$pkgdir/usr/share/fcitx5/addon/meltype.conf"
        sed "s|@DIR@|/opt/meltype|g" "$dir/fcitx5/meltype.conf" > meltype-inputmethod.conf
        install -Dm644 meltype-inputmethod.conf "$pkgdir/usr/share/fcitx5/inputmethod/meltype.conf"
    fi
}
