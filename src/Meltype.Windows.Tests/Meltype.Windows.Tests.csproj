<Project Sdk="Microsoft.NET.Sdk">
  <!-- NuGet feeds are disabled in this repo (nuget.config), so tests use a tiny built-in runner instead of xUnit. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Windows\Meltype.Windows.csproj" />
    <ProjectReference Include="..\Meltype.Core.Tests\Meltype.Core.Tests.csproj" />
  </ItemGroup>
</Project>
