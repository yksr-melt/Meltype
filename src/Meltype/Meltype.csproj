<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: Exe にすると、エクスプローラーやタスク スケジューラから起動したときにコンソールの窓が一瞬フォーカスを取り、その間に打ったキーが消える。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Meltype</AssemblyName>
    <RootNamespace>Meltype</RootNamespace>
    <Version>1.4.1-pre.2</Version>
    <Product>Meltype</Product>
    <Authors>Yukishiro</Authors>
    <Copyright>Copyright (C) 2026 雪代 / Yukishiro. GPL-3.0-or-later</Copyright>
    <Description>半角/全角 キーを押さなくても日本語と英語を打ち分けられるようにする常駐ツール</Description>
    <!-- Meltype.exe のアイコン (インストーラーの「アプリと機能」にも出る)。web/scripts/make-icons.mjs で作る -->
    <ApplicationIcon>..\..\native\tip\meltype.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WinRtCandidates で COM の関数表を直接呼ぶため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meltype.Tests" />
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 今の版のリリースノート (docs/release-notes/<版>.md) を配布物の release-notes に入れる。更新したあとの初めての起動で見せる (issue #1207) -->
    <None Include="..\..\docs\release-notes\$(Version).md" Condition="Exists('..\..\docs\release-notes\$(Version).md')" Link="release-notes\$(Version).md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- タグのビルド (GitHub Actions の GITHUB_REF_TYPE=tag。手で push したタグも) では、リリースノートが無ければ止める。開発中のビルドは無くてもよい (GitHub のリリースのページへ案内する) -->
  <Target Name="RequireReleaseNotes" BeforeTargets="Build" Condition="'$(GITHUB_REF_TYPE)' == 'tag' And !Exists('..\..\docs\release-notes\$(Version).md')">
    <Error Text="docs/release-notes/$(Version).md がありません。リリースノートを書いて main に入れてから、タグを付けてください (docs/RELEASE.md)。" />
  </Target>
</Project>
