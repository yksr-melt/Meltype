<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Mac 版の IME (mac/ の Swift) から呼ぶ、Meltype の入力の本体のライブラリ。
    Mac で NativeAOT の共有ライブラリにする (mac/build.sh):
      dotnet publish src/Meltype.Mac.Native -c Release -r osx-arm64 -p:PublishAot=true -p:NativeLib=Shared
    PublishAot はここには書かない (書くと Windows でのふつうのビルドでも NuGet から AOT のコンパイラを取りに行くため)。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MeltypeNative</AssemblyName>
    <RootNamespace>Meltype.Mac</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 設定・学習データの JSON は、ビルド時に作った型の情報 (Meltype.Core の SettingsJsonContext など、ソース生成) で読み書きする。
         reflection は NativeAOT では列挙型のプロパティ・private な型を読めない (issue #151)。念のため有効のままにし、Meltype.Core の型も削らずに残す。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Meltype.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
  <!-- Linux-bionic .so needs a stable SONAME. macOS clang does not support
       ELF-specific SONAME and hash-style linker flags. Do not affect osx-arm64. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-bionic-arm64' Or '$(RuntimeIdentifier)' == 'linux-bionic-x64'">
    <LinkerArg Include="-Wl,-soname,libMeltypeNative.so" />
    <LinkerArg Include="-Wl,--hash-style=both" />
  </ItemGroup>
</Project>
