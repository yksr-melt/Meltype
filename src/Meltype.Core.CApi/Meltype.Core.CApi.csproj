<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Meltype.Core を C の関数で呼べるようにするライブラリ。Mac・Linux 版の IME が dlopen する。
    NativeAOT の共有ライブラリにする (mac/build.sh・linux/build.sh):
      dotnet publish src/Meltype.Core.CApi -c Release -r osx-arm64 -p:PublishAot=true -p:NativeLib=Shared
    PublishAot はここには書かない (書くと Windows でのふつうのビルドでも NuGet から AOT のコンパイラを取りに行くため)。
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>MeltypeNative</AssemblyName>
    <RootNamespace>Meltype.CApi</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 設定・学習データの JSON は、ビルド時に作った型の情報 (Meltype.Core の SettingsJsonContext など、ソース生成) で読み書きする。
         reflection は NativeAOT では列挙型のプロパティ・private な型を読めない (issue #151)。念のため有効のままにし、Meltype.Core の型も削らずに残す。 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Meltype.Core" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
</Project>
