# エディターと dotnet format・Roslyn の解析の設定 (issue #1083)。
# 解析のルールは、CI (.github/workflows/quality.yml) では AnalysisLevel=latest-recommended で流し、警告として出す。
# 重要度を変えるときは、下の [*.cs] に dotnet_diagnostic.<ID>.severity = error / warning / suggestion / none を足す。
# error にするのは、既存のコードに 1 件も無いことを確かめてから (Windows 版のビルドも止まるため)。
root = true

# Windows PowerShell 5.1 (shell: powershell) は BOM の無いスクリプトを UTF-8 として読まない
[*.{ps1,psm1}]
charset = utf-8-bom

[*.cs]
indent_style = space
indent_size = 4
# 対応表 (キーの表など) は 1 行に複数の項目を並べる
csharp_new_line_before_members_in_object_initializers = false
